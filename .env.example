# MySQL - Order Service
MYSQL_ORDER_ROOT_PASSWORD=root
MYSQL_ORDER_DATABASE=order_db
MYSQL_ORDER_USER=order_user
MYSQL_ORDER_PASSWORD=order_pass
MYSQL_ORDER_PORT=3313

# MySQL - Payment Service
MYSQL_PAYMENT_ROOT_PASSWORD=root
MYSQL_PAYMENT_DATABASE=payment_db
MYSQL_PAYMENT_USER=payment_user
MYSQL_PAYMENT_PASSWORD=payment_pass
MYSQL_PAYMENT_PORT=3314

# Application ports
ORDER_SERVICE_PORT=8085
PAYMENT_SERVICE_PORT=8086

# Kafka / Zookeeper (host ports — see ../MASTER_PORTS.md)
KAFKA_BOOTSTRAP_SERVERS=localhost:9093
