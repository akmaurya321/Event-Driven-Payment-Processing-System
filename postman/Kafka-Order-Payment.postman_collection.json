{
  "info": {
    "name": "Kafka Order Payment System",
    "description": "API collection for order-service (8085) and payment-service (8086)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "orderBaseUrl",
      "value": "http://localhost:8085"
    },
    {
      "key": "paymentBaseUrl",
      "value": "http://localhost:8086"
    },
    {
      "key": "orderId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Order Service",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Alice Johnson\",\n  \"productName\": \"Wireless Headphones\",\n  \"quantity\": 2,\n  \"amount\": 149.99\n}"
            },
            "url": "{{orderBaseUrl}}/api/orders"
          }
        },
        {
          "name": "Get All Orders",
          "request": {
            "method": "GET",
            "url": "{{orderBaseUrl}}/api/orders"
          }
        },
        {
          "name": "Get Order By ID",
          "request": {
            "method": "GET",
            "url": "{{orderBaseUrl}}/api/orders/{{orderId}}"
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{orderBaseUrl}}/api/orders/{{orderId}}/status?status=PAID",
              "host": ["{{orderBaseUrl}}"],
              "path": ["api", "orders", "{{orderId}}", "status"],
              "query": [
                {
                  "key": "status",
                  "value": "PAID"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Payment Service",
      "item": [
        {
          "name": "Get All Payments",
          "request": {
            "method": "GET",
            "url": "{{paymentBaseUrl}}/api/payments"
          }
        },
        {
          "name": "Get Payment By Order ID",
          "request": {
            "method": "GET",
            "url": "{{paymentBaseUrl}}/api/payments/order/{{orderId}}"
          }
        }
      ]
    }
  ]
}
